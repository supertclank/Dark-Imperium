  "levelFeatures": [
    {
      "id": "di.feature.class.veteran.level_1.guardsman_training",
      "name": "Guardsman Training",
      "description": "Gain proficiency in two skills from Athletics, Insight, \nIntimidation, Medicine, Perception, Stealth, and Survival. \nYou also gain proficiency with one specialist weapon \ngroup: sniper weapons, plasma weapons, melta \nweapons, or heavy weapons."
    },
    {
      "id": "di.feature.class.veteran.level_1.tactical_aim",
      "name": "Tactical Aim",
      "description": "As a bonus action, choose one creature you can see \nwithin weapon range. Until the end of your turn,\nyour next ranged weapon attack against that creature \ndeals bonus damage equal to your proficiency\nbonus."
    }
  ],
