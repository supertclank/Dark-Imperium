  "species": [
    {
      "id": "di.species.human",
      "name": "Human",
      "description": "3.1 Human\nHumans are the baseline of the Imperium: adaptable, \nambitious, fragile, and dangerously determined.\nAbility Scores: +2 to one ability score and +1 to \nanother.\nSize: Medium.\nSpeed: 30 ft.\nAvailable Classes: Veteran, Zealot, Psyker, Arbites \nEnforcer, Hive Scum.\n3.1.1 Human Traits\nImperial Adaptability: Gain proficiency in one skill of \nyour choice.\nBroad Training: Gain one additional weapon, tool, or \nlanguage proficiency.\nFaith, Fear, or Discipline: Once per long rest, when you \nfail a saving throw, you may reroll it. You must\nuse the new result."
    }
  ],
  "origins": [
    {
      "id": "di.background.schola_progenium",
      "name": "Schola Progenium",
      "description": "4.6 Schola Progenium\nRaised in harsh Imperial institutions to become a soldier, \njudge, officer, priest, or specialist.\nAllowed Species: Human.\nSkill Proficiency: Choose one from History or Religion, \nand one from Intimidation or Persuasion.\nDrilled Obedience: You have advantage on saving \nthrows against fear while following a direct order,\nholding formation, or protecting an Imperial objective.\nImperial Education: You can identify major Imperial \norganisations, ranks, symbols, rites, and\nprocedures."
    }
  ],
  "classes": [
    {
      "id": "di.class.veteran",
      "name": "Veteran",
      "description": "11.1 Veteran\nProfessional soldier, marksman, squad leader, or hardened guardsman.\nAllowed Species: Human, Ratling.\nHit Die: d10.\nPrimary Abilities: Dexterity, Wisdom.\nSaving Throws: Dexterity, Wisdom.\nArmour: Light, medium, flak, carapace.\nWeapons: Simple weapons, martial melee weapons, pistols, basic firearms, grenades."
    }
  ],
