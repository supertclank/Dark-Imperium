    "manualRules": [
      {
        "source": {
          "id": "di.feature.species.human.traits"
        },
        "localId": "source_rule",
        "text": "3.1 Human\nHumans are the baseline of the Imperium: adaptable, \nambitious, fragile, and dangerously determined.\nSize: Medium.\n\nAvailable Classes: Veteran, Zealot, Psyker, Arbites \nEnforcer, Hive Scum.\n3.1.1 Human Traits\nBroad Training: Gain one additional weapon, tool, or \nlanguage proficiency.\nFaith, Fear, or Discipline: Once per long rest, when you \nfail a saving throw, you may reroll it. You must\nuse the new result.",
        "reason": "Source transcribed; automatic mapping has not been validated for this import slice."
      },
      {
        "source": {
          "id": "di.feature.origin.schola_progenium"
        },
        "localId": "source_rule",
        "text": "4.6 Schola Progenium\nRaised in harsh Imperial institutions to become a soldier, \njudge, officer, priest, or specialist.\nAllowed Species: Human.\n\nDrilled Obedience: You have advantage on saving \nthrows against fear while following a direct order,\nholding formation, or protecting an Imperial objective.\nImperial Education: You can identify major Imperial \norganisations, ranks, symbols, rites, and\nprocedures.",
        "reason": "Source transcribed; automatic mapping has not been validated for this import slice."
      },
      {
        "source": {
          "id": "di.feature.class.veteran.training"
        },
        "localId": "source_rule",
        "text": "11.1 Veteran\nProfessional soldier, marksman, squad leader, or hardened guardsman.\nAllowed Species: Human, Ratling.\nHit Die: d10.\nPrimary Abilities: Dexterity, Wisdom.\nSaving Throws: Dexterity, Wisdom.\nArmour: Light, medium, flak, carapace.\nWeapons: Simple weapons, martial melee weapons, pistols, basic firearms, grenades.\n",
        "reason": "Source transcribed; automatic mapping has not been validated for this import slice."
      },
      {
        "source": {
          "id": "di.feature.class.veteran.level_1.tactical_aim"
        },
        "localId": "source_rule",
        "text": "As a bonus action, choose one creature you can see \nwithin weapon range. Until the end of your turn,\nyour next ranged weapon attack against that creature \ndeals bonus damage equal to your proficiency\nbonus.",
        "reason": "Source transcribed; automatic mapping has not been validated for this import slice."
      }
    ],
